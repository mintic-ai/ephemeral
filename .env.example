# Docker On-Demand Configuration Example
# Copy this file to .env and modify the values as needed

# =============================================================================
# Docker Configuration
# =============================================================================

# Path to Docker daemon socket
# Default: /var/run/docker.sock
# On macOS with Docker Desktop: /var/run/docker.sock
# On Windows with Docker Desktop: //./pipe/docker_engine
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Default Docker image to use when none is specified
# Popular options: nginx:alpine, httpd:alpine, node:alpine
DOCKER_DEFAULT_IMAGE=nginx:alpine

# Docker network mode for containers
# Options: bridge, host, none, or custom network name
DOCKER_NETWORK_MODE=bridge

# Port range for container allocation
# Containers will be assigned ports within this range
DOCKER_PORT_RANGE_START=8000
DOCKER_PORT_RANGE_END=9000

# =============================================================================
# Cleanup Configuration
# =============================================================================

# How often to check for inactive containers (in seconds)
# 300 = 5 minutes, 600 = 10 minutes, 1800 = 30 minutes
CLEANUP_INTERVAL=300

# How long a container can be inactive before cleanup (in seconds)
# 300 = 5 minutes, 600 = 10 minutes, 1800 = 30 minutes, 3600 = 1 hour
CLEANUP_INACTIVITY_TIMEOUT=600

# Maximum number of retry attempts for failed container removals
CLEANUP_MAX_RETRY_ATTEMPTS=3

# Timeout for force removal of containers (in seconds)
CLEANUP_FORCE_REMOVAL_TIMEOUT=30

# =============================================================================
# API Server Configuration
# =============================================================================

# Port for the REST API server
API_PORT=3000

# Host/interface to bind the API server
# localhost = local access only
# 0.0.0.0 = accept connections from any IP
API_HOST=localhost

# Enable API authentication (not implemented yet)
API_AUTH_ENABLED=false

# =============================================================================
# Development/Debug Configuration
# =============================================================================

# Log level (not implemented yet, but reserved for future use)
# Options: debug, info, warn, error
# LOG_LEVEL=info

# Enable debug mode (not implemented yet)
# DEBUG=false

# =============================================================================
# Production Configuration Examples
# =============================================================================

# For production deployment, consider these settings:

# Use a more restrictive cleanup interval
# CLEANUP_INTERVAL=600

# Longer inactivity timeout for production workloads
# CLEANUP_INACTIVITY_TIMEOUT=1800

# Bind to all interfaces for external access
# API_HOST=0.0.0.0

# Use a different port if 3000 is occupied
# API_PORT=8080

# Larger port range for more concurrent containers
# DOCKER_PORT_RANGE_START=8000
# DOCKER_PORT_RANGE_END=10000