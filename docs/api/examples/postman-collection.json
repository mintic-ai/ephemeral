		{

			"name": "Container Management",
			"item": [
				{
					"name": "Create Container (Default)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Container created successfully', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data).to.have.property('id');",
									"    pm.expect(jsonData.data).to.have.property('status');",
									"    pm.expect(jsonData.data).to.have.property('connection');",
									"});",
									"",
									"pm.test('Container has connection details', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.connection).to.have.property('host');",
									"    pm.expect(jsonData.data.connection).to.have.property('port');",
									"    pm.expect(jsonData.data.connection).to.have.property('url');",
									"});",
									"",
									"// Save container ID for other requests",
									"if (pm.response.code === 201) {",
									"    const jsonData = pm.response.json();",
									"    pm.collectionVariables.set('containerId', jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
