		{
			"name": "Health Check",
			"item": [
				{
					"name": "Get System Health",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response has success field', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('success');",
									"    pm.expect(jsonData.success).to.be.true;",
									"});",
									"",
									"pm.test('Health data is present', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('status');",
									"    pm.expect(jsonData.data).to.have.property('containers');",
									"    pm.expect(jsonData.data).to.have.property('docker');",
									"    pm.expect(jsonData.data).to.have.property('system');",
									"});",
									"",
									"pm.test('System status is healthy', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.status).to.equal('healthy');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health"
							]
						},
						"description": "Check the system health and get status information including active containers, Docker version, and system metrics."
					},
					"response": [
						{
							"name": "Healthy System",
							"originalRequest": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{baseUrl}}/health",
									"host": [
										"{{baseUrl}}"
									],
									"path": [
										"health"
									]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"cookie": [],
							"body": "{\n  \"success\": true,\n  \"data\": {\n    \"status\": \"healthy\",\n    \"timestamp\": \"2025-01-23T10:30:00.000Z\",\n    \"version\": \"1.0.0\",\n    \"containers\": {\n      \"active\": 3,\n      \"total\": 3\n    },\n    \"docker\": {\n      \"version\": \"24.0.7\",\n      \"containers\": 5,\n      \"images\": 12\n    },\n    \"system\": {\n      \"uptime\": 3600.5,\n      \"memory\": {\n        \"rss\": 45678592,\n        \"heapTotal\": 20971520,\n        \"heapUsed\": 15728640,\n        \"external\": 1048576,\n        \"arrayBuffers\": 524288\n      }\n    }\n  }\n}"
						}
					]
				}
			],
			"description": "Health check endpoints for monitoring system status"
